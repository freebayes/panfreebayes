#!/usr/bin/env bash
#
# Fake minimap2 -- logs its invocation and emits a minimal valid SAM stream,
# so align_region can be exercised through samtools sort/index without a real
# minimap2 binary or FASTQ.
#
set -euo pipefail
: "${FAKE_LOG:?FAKE_LOG must be set}"
echo "minimap2 $*" >> "$FAKE_LOG"

cat <<'EOF'
@HD	VN:1.6	SO:unsorted
@SQ	SN:fake_region	LN:32
fake_read	4	*	0	0	*	*	0	0	ACGT	IIII
EOF
