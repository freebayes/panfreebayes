#!/usr/bin/env bash
#
# Fake odgi -- logs its invocation and emits plausible dummy output, so the
# Snakemake dry-run test can confirm exact command construction (extract's
# -r/-c/-o, paths' -f) without needing a real odgi binary or graph.
#
set -euo pipefail
: "${FAKE_LOG:?FAKE_LOG must be set}"
echo "odgi $*" >> "$FAKE_LOG"

case "${1:-}" in
  extract)
    out=""
    prev=""
    for a in "$@"; do
      [ "$prev" = "-o" ] && out="$a"
      prev="$a"
    done
    [ -n "$out" ] || { echo "fake odgi extract: no -o given" >&2; exit 2; }
    printf 'fake .og produced by fake odgi extract\n' > "$out"
    ;;
  paths)
    # -f: print a tiny dummy FASTA to stdout, matching what a real
    # `odgi paths -f` would produce (the extracted region's own sequence).
    printf '>fake_region\nACGTACGTACGTACGTACGTACGTACGTACGT\n'
    ;;
  *)
    echo "fake odgi: unhandled subcommand: ${1:-}" >&2
    exit 2
    ;;
esac
