#!/usr/bin/env bash
#
# Fake samtools -- logs its invocation; `sort -o FILE` copies stdin to FILE,
# `index FILE` touches FILE.bai. Enough to let align_region/call_variants
# complete without a real samtools binary or real alignment data.
#
set -euo pipefail
: "${FAKE_LOG:?FAKE_LOG must be set}"
echo "samtools $*" >> "$FAKE_LOG"

case "${1:-}" in
  sort)
    out=""
    prev=""
    for a in "$@"; do
      [ "$prev" = "-o" ] && out="$a"
      prev="$a"
    done
    [ -n "$out" ] || { echo "fake samtools sort: no -o given" >&2; exit 2; }
    cat > "$out"
    ;;
  index)
    target="${2:-}"
    [ -n "$target" ] || { echo "fake samtools index: no target given" >&2; exit 2; }
    touch "$target.bai"
    ;;
  *)
    echo "fake samtools: unhandled subcommand: ${1:-}" >&2
    exit 2
    ;;
esac
